# 4. 🔍 MAIN AUTO-FILTER / SEARCH LOGIC (Auto Photo Display & Smart Regex)
# =====================================================================
@Client.on_message(filters.text & filters.group & filters.incoming & ~filters.command(["verify", "connect", "id", "index", "ready", "list", "request", "add_story", "del_story"]))
async def search(bot, message):
    if message.text.startswith("/"): return
    original_query = message.text.lower().strip()
    if len(original_query) < 3: return 

    start_time = time.time()
    backup_photo = globals().get('BACKUP_PHOTO', "https://i.ibb.co/bRF7VnK9/photo-2026-04-30-08-44-00-7634470373420957700.jpg")
    suggestion_photo = "https://i.ibb.co/kVYWwBQJ/photo-2026-04-22-13-45-49-7631579452408856584.jpg"

    # --- यूज़र के मैसेज से एपिसोड नंबर निकालना ---
    query = original_query
    target_ep = None
    
    ep_match = re.search(r"(?:ep|episode)\s*(\d+)", query)
    if ep_match:
        target_ep = int(ep_match.group(1)) 
        query = re.sub(r"(?:ep|episode)\s*\d+", "", query).strip()

    keywords = query.split()
    regex_pattern = ".*".join(map(re.escape, keywords))
    
    try:
        db_results = list(database.posts.find({"title": {"$regex": regex_pattern, "$options": "i"}}))
    except Exception: 
        return

    # --- रेंज के हिसाब से बटन फिल्टर करना ---
    if target_ep is not None and db_results:
        filtered_results = []
        for post in db_results:
            btn_text = post['display_name']
            range_match = re.search(r"(\d+)\s*(?:to|-)\s*(\d+)", btn_text, re.IGNORECASE)
            
            if range_match:
                start_ep = int(range_match.group(1))
                end_ep = int(range_match.group(2))
                if start_ep <= target_ep <= end_ep:
                    filtered_results.append(post)
                    break 
            else:
                single_match = re.search(r"\b(\d+)\b", btn_text)
                if single_match and int(single_match.group(1)) == target_ep:
                    filtered_results.append(post)
                    break
                    
        if filtered_results:
            db_results = filtered_results
        else:
            db_results = []

    safe_cb_query = query[:20].strip()

    if db_results:
        try:
            await message.react(emoji=random.choice(REACTION_DIRECT), big=True)
        except Exception:
            await message.react(emoji="⚡️", big=True)
            pass
            
        story_buttons = []
        photo = None
        
        displayed_results = db_results[:10]
        for post in displayed_results:
            if not photo and post.get("photo_id"):
                photo = post.get("photo_id")
            story_buttons.append([InlineKeyboardButton(f"📖 {post['display_name']}", url=post['link'], style=enums.ButtonStyle.DANGER)])
            
        total_pages = math.ceil(len(db_results) / 10)
        if total_pages > 1:
            story_buttons.append([
                InlineKeyboardButton("Pᴀɢᴇ", callback_data="noop", style=enums.ButtonStyle.PRIMARY),
                InlineKeyboardButton(f"1/{total_pages}", callback_data="noop", style=enums.ButtonStyle.SUCCESS),
                InlineKeyboardButton("Nᴇxᴛ ➡️", callback_data=f"pag_1_{safe_cb_query}", style=enums.ButtonStyle.PRIMARY)
            ])
            
        story_buttons.append([InlineKeyboardButton("⚠️ RᴇP0ʀT Bʀ0ᴋEɴ LɪNᴋ", callback_data=f"report_{safe_cb_query}", style=enums.ButtonStyle.SUCCESS)])
        story_buttons.append([
            InlineKeyboardButton("📢 STORY CHANNEL", url="https://t.me/freestoryhubMR", style=enums.ButtonStyle.PRIMARY),
            InlineKeyboardButton("💬 REQUEST GROUP", url="https://t.me/pratilipifm0900", style=enums.ButtonStyle.PRIMARY)
        ])
        
        elapsed_time = round(time.time() - start_time, 2)
        group_name = message.chat.title if message.chat.title else "Story Group"

        caption = (
            f"☠️ <b>Sᴛ0ʀY TɪTʟE:-</b> {query.title()}\n"
            f"📝 <b>RᴇǫᴜEsᴛᴇ∂ BY:-</b> {message.from_user.mention if message.from_user else 'User'}\n"
            f"⏰ <b>RᴇsᴜLᴛ TɪMᴇ:-</b> {elapsed_time} sᴇᴄ0ɴDS\n"
            f"📁 <b>Gʀ0ᴜP NᴀᴍE:-</b> {group_name}\n\n"
            f"тнιѕ мєѕѕαgє ωιℓℓ вє αυтσмαтι¢αℓℓу ∂єℓєтє∂ ιη 5 мιηυтєѕ..!"
        )
        
        try:
            msg = await message.reply_photo(photo=photo if photo else backup_photo, caption=caption, reply_markup=InlineKeyboardMarkup(story_buttons))
        except Exception:
            msg = await message.reply_photo(photo=backup_photo, caption=caption, reply_markup=InlineKeyboardMarkup(story_buttons))
            
        asyncio.create_task(safe_delete_message(msg, 300))
        return

    # --- Suggestion System ---
    try:
        all_titles = database.posts.distinct("title")
    except Exception: return

    if all_titles:
        matches = process.extract(query, all_titles, limit=6, scorer=fuzz.token_set_ratio)
        suggestion_buttons = [[InlineKeyboardButton(f"🎬 {title.title()}", callback_data=f"fuzzy_{title[:25]}")] 
                              for title, score in matches if score > 55]
        
        if suggestion_buttons:
            try:
                await message.react(emoji=random.choice(REACTION_FUZZY), big=True)
            except Exception:
                await message.react(emoji="🤔", big=True)
                pass

            suggestion_buttons.append([InlineKeyboardButton("❓ H0ᴡ T0 RᴇǫᴜEsᴛ?", callback_data="how_to_req", style=enums.ButtonStyle.PRIMARY)])
        try:
            msg = await message.reply_photo(
                photo=suggestion_photo, 
                caption=f"<b>🔻 I C0ᴜ Lᴅ N0ᴛ FɪNᴅ Aɴ ExᴀCᴛ MᴀTᴄH F0ʀ '{original_query}'.\n\nDɪD Y0ᴜ MᴇAɴ OɴE Oғ TʜEsᴇ?</b>", 
                reply_markup=InlineKeyboardMarkup(suggestion_buttons)
            )
            asyncio.create_task(safe_delete_message(msg, 300))
        except Exception: 
            pass


