# Background message deletion helper (Users ke liye group me)
async def safe_delete_message(msg, delay: int):
    await asyncio.sleep(delay)
    try:
        await msg.delete()
    except Exception:
        pass

# डेटाबेस में एक साथ सारे एपिसोड्स सेव करने का हेल्पर फंक्शन
async def save_bulk_stories_to_db(bot, message, user_id):
    state = ADMIN_STATES[user_id]
    
    # UI क्लीन करने के लिए 'Step 3' वाला आखरी इंस्ट्रक्शन मैसेज डिलीट करना
    if "last_msg_id" in state:
        try:
            await bot.delete_messages(chat_id=message.chat.id, message_ids=state["last_msg_id"])
        except Exception:
            pass
            
    try:
        success_count = 0
        inserted_details = ""
        preview_buttons = []
        
        # Har line se episode aur link nikal kar save karna
        for ep_data in state["episodes_list"]:
            database.posts.insert_one({
                "title": state["keyword"],
                "display_name": ep_data["name"],
                "link": ep_data["link"],
                "photo_id": state.get("photo_id")  # Sabhi episodes me same poster attach ho jayega
            })
            success_count += 1
            inserted_details += f"• `{ep_data['name']}` ➜ [Link]({ep_data['link']})\n"
            preview_buttons.append([InlineKeyboardButton(f"📖 {ep_data['name']}", url=ep_data['link'])])
            
        caption = (
            "🎉 **Sᴛ0ʀY & Aʟʟ Bᴜᴛᴛ0ɴs Aᴅᴅᴇᴅ SᴜᴄᴄᴇssғᴜʟLʏ!**\n\n"
            f"🎬 **Sᴛ0ʀY Nᴀᴍᴇ:** `{state['keyword'].title()}`\n"
            f"📦 **T0ᴛAʟ Bᴜᴛᴛ0ɴs:** `{success_count}`\n\n"
            f"**Lɪsᴛ 0ғ Aᴅᴅᴇᴅ Eᴘɪs0ᴅᴇs:**\n{inserted_details}"
        )
        
        if state.get("photo_id"):
            await bot.send_photo(chat_id=message.chat.id, photo=state["photo_id"], caption=caption, reply_markup=InlineKeyboardMarkup(preview_buttons))
        else:
            await bot.send_message(chat_id=message.chat.id, text=caption, reply_markup=InlineKeyboardMarkup(preview_buttons), disable_web_page_preview=True)
            
    except Exception as e:
        await bot.send_message(chat_id=message.chat.id, text=f"❌ **EʀR0ʀ sᴀᴠɪɴɢ ᴛ0 DB:** {e}")
    
    # Process complete hone par state clear karein
    ADMIN_STATES.pop(user_id, None)


