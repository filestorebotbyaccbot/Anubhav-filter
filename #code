@Client.on_callback_query(filters.regex(r"^(fuzzy|how_to_req|report_|delbtn_|delall_|pag_|fpag_|noop|cancel_add|skip_photo)"))
async def cb_handler(bot, update):
    data = update.data
    user_id = update.from_user.id
    
    if data == "noop":
        return await update.answer()
        
    if data == "cancel_add":
        if user_id in ADMIN_STATES and "last_msg_id" in ADMIN_STATES[user_id]:
            try: await bot.delete_messages(chat_id=update.message.chat.id, message_ids=ADMIN_STATES[user_id]["last_msg_id"])
            except Exception: pass
        ADMIN_STATES.pop(user_id, None)
        return await update.answer("❌ Process Cancelled & Cleaned!", show_alert=True)

    elif data == "skip_photo":
        if user_id in ADMIN_STATES and ADMIN_STATES[user_id]["step"] == "photo":
            state = ADMIN_STATES[user_id]
            
            try: await update.message.delete()
            except Exception: pass
            
            state["photo_id"] = None
            state["step"] = "episodes"
            
            cancel_markup = InlineKeyboardMarkup([[InlineKeyboardButton("❌ CᴀɴCᴇLs Pʀ0...", callback_data="cancel_add")]])
            msg = await bot.send_message(
                chat_id=update.message.chat.id,
                text="⏭️ Photo skipped! (Backup image use hogi).\n\n"
                     "📝 **SᴛEᴘ 3: SᴇNᴅ MᴜLᴛɪPʟEs Eᴘɪs0ᴅEs (Bulk Format)**\n\n"
                     "Ab ek sath saare episodes send karein (Har line par naya button):\n\n"
                     "`Episode 1 | https://t.me/link1`n"
                     "`Episode 2 | https://t.me/link2`n"
                     "`Episode 3 | https://t.me/link3`",
                reply_markup=cancel_markup
            )
            state["last_msg_id"] = msg.id
            return await update.answer() # यहाँ से टेक्स्ट हटा दिया
    
    elif data.startswith("pag_"):
        await update.answer() # यहाँ से 'Loading Page...' हटा दिया (अब सिर्फ साइलेंटली लोड होगा)
        _, page, query_val = data.split("_", 2)
        page = int(page)
        
        keywords = query_val.split()
        regex_pattern = ".*".join(map(re.escape, keywords))
        
        db_results = list(database.posts.find({"title": {"$regex": regex_pattern, "$options": "i"}}))
        if db_results:
            story_buttons = []
            start_idx = page * 10
            end_idx = start_idx + 10
            displayed_results = db_results[start_idx:end_idx]
            
            for post in displayed_results:
                story_buttons.append([InlineKeyboardButton(f"📖 {post['display_name']}", url=post['link'], style=enums.ButtonStyle.DANGER)])
                
            total_pages = math.ceil(len(db_results) / 10)
            nav_buttons = []
            
            if page > 0:
                nav_buttons.append(InlineKeyboardButton("⬅️ BᴀCᴋ", callback_data=f"pag_{page-1}_{query_val}", style=enums.ButtonStyle.PRIMARY))
            else:
                nav_buttons.append(InlineKeyboardButton("Pᴀɢe", callback_data="noop", style=enums.ButtonStyle.SUCCESS))
                
            nav_buttons.append(InlineKeyboardButton(f"{page+1}/{total_pages}", callback_data="noop", style=enums.ButtonStyle.PRIMARY))
            
            if end_idx < len(db_results):
                nav_buttons.append(InlineKeyboardButton("Nᴇxᴛ ➡️", callback_data=f"pag_{page+1}_{query_val}", style=enums.ButtonStyle.PRIMARY))
            else:
                nav_buttons.append(InlineKeyboardButton("Pᴀɢe", callback_data="noop", style=enums.ButtonStyle.SUCCESS))
                
            story_buttons.append(nav_buttons)  
            story_buttons.append([InlineKeyboardButton("⚠️ RᴇP0ʀT Bʀ0ᴋEɴ LɪNᴋ", callback_data=f"report_{query_val}", style=enums.ButtonStyle.SUCCESS)])
            story_buttons.append([
                InlineKeyboardButton("📢 STORY CHANNEL", url="https://t.me/freestoryhubMR", style=enums.ButtonStyle.PRIMARY),
                InlineKeyboardButton("💬 REQUEST GROUP", url="https://t.me/pratilipifm0900", style=enums.ButtonStyle.PRIMARY)
            ])
            
            try:
                await update.message.edit_reply_markup(reply_markup=InlineKeyboardMarkup(story_buttons))
            except Exception:
                pass

    elif data.startswith("fuzzy_"):
        await update.answer() # यहाँ से 'Fetching Story...' हटा दिया (अब सीधा मैसेज एडिट/सेंड होगा)
        start_time = time.time()
        value = data.split("_", 1)[1]
        
        db_results = list(database.posts.find({"title": {"$regex": f"^{re.escape(value)}", "$options": "i"}}))
        safe_value = value[:20].strip()

        if db_results:
            story_buttons = []
            photo = None
            
            displayed_results = db_results[:10]
            for post in displayed_results:
