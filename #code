@Client.on_message(filters.private & filters.user(ADMIN) & filters.text & ~filters.command(["start", "help", "add_story", "del_story"]))
async def handle_story_inputs(bot, message):
    user_id = message.from_user.id
    if user_id not in ADMIN_STATES:
        return 

    state = ADMIN_STATES[user_id]
    current_step = state["step"]
    cancel_markup = InlineKeyboardMarkup([[InlineKeyboardButton("❌ CᴀɴCᴇLs Pʀ0... ", callback_data="cancel_add")]])

    try: await message.delete()
    except Exception: pass

    if "last_msg_id" in state:
        try: await bot.delete_messages(chat_id=message.chat.id, message_ids=state["last_msg_id"])
        except Exception: pass

    if current_step == "keyword":
        state["keyword"] = message.text.lower().strip()
        state["step"] = "photo"
        
        skip_markup = InlineKeyboardMarkup([
            [InlineKeyboardButton("⏭️ SᴋIᴘ Pʜ0ᴛ0 (UsE BᴀCᴋᴜP)", callback_data="skip_photo")],
            [InlineKeyboardButton("❌ CᴀɴCᴇLs Pʀ0...", callback_data="cancel_add")]
        ])
        msg = await bot.send_message(
            chat_id=message.chat.id,
            text=f"✅ Sᴛ0ʀY NᴀMᴇ SᴀVᴇD: `{state['keyword'].title()}`\n\n"
                 "🖼️ **SᴛEᴘ 2:** Please send the **Story Poster / Image**:\n"
                 "_(Direct photo bhejें ya link text me bhejें)_",
            reply_markup=skip_markup
        )
        state["last_msg_id"] = msg.id

    elif current_step == "photo":
        state["photo_id"] = message.text.strip()
        state["step"] = "episodes"
        msg = await bot.send_message(
            chat_id=message.chat.id,
            text="✅ P0sᴛEʀ SᴀVᴇD!\n\n"
                 "📝 **SᴛEᴘ 3: SᴇNᴅ MᴜLᴛɪPʟEs Eᴘɪs0ᴅEs (Bulk Format)**\n\n"
                 "Ek sath saare episodes send karein (Har line par naya button):\n\n"
                 "`Episode 1 | https://t.me/link1`n"
                 "`Episode 2 | https://t.me/link2`n"
                 "`Episode 3 | https://t.me/link3`",
            reply_markup=cancel_markup
        )
        state["last_msg_id"] = msg.id

    elif current_step == "episodes":
        lines = [line.strip() for line in message.text.split("\n") if line.strip()]
        valid_episodes = []
        
        for line in lines:
            parts = [p.strip() for p in line.split("|")]
            if len(parts) >= 2 and parts[1].startswith("http"):
                valid_episodes.append({"name": parts[0], "link": parts[1]})
        
        if not valid_episodes:
            msg = await bot.send_message(
                chat_id=message.chat.id,
                text="❌ **Format Error!** Kripya is format me bhejein:\n`Episode Name | https://link`",
                reply_markup=cancel_markup
            )
            state["last_msg_id"] = msg.id
            return
            
        state["episodes_list"] = valid_episodes
        await save_bulk_stories_to_db(bot, message, user_id)

